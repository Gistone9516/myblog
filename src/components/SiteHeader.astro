---
// 상단 바. hudi.blog처럼 왼쪽은 사이트 이름, 오른쪽은 아이콘만 둔다
import { SITE } from '../site.config';
import { withBase } from '../utils/withBase';
import ThemeToggle from './ThemeToggle.astro';

const LINKS = [
	{ href: '/tags/', label: '태그', icon: 'tag' },
	{ href: '/series/', label: '연재', icon: 'list' },
	{ href: '/rss.xml', label: 'RSS', icon: 'rss' },
	{ href: '/search/', label: '검색', icon: 'search' },
];
---

<header class="site-header">
	<div class="bar">
		<a class="brand" href={withBase('/')}>{SITE.title}</a>
		<div class="tools">
			<ThemeToggle />
			{
				LINKS.map((link) => (
					<a class="icon-button" href={withBase(link.href)} aria-label={link.label} title={link.label}>
						{link.icon === 'tag' && (
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M3 12V4h8l10 10-8 8L3 12z" />
								<circle cx="7.5" cy="8.5" r="1.3" />
							</svg>
						)}
						{link.icon === 'list' && (
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M9 6h12M9 12h12M9 18h12" />
								<circle cx="4.5" cy="6" r="1.2" />
								<circle cx="4.5" cy="12" r="1.2" />
								<circle cx="4.5" cy="18" r="1.2" />
							</svg>
						)}
						{link.icon === 'rss' && (
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" />
								<circle cx="6" cy="18" r="1.4" />
							</svg>
						)}
						{link.icon === 'search' && (
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<circle cx="11" cy="11" r="6.5" />
								<path d="M16 16l4.5 4.5" />
							</svg>
						)}
					</a>
				))
			}
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 5;
		background: var(--bg);
		box-shadow: var(--header-shadow);
	}

	.bar {
		width: min(100% - var(--gutter) * 2, 1040px);
		margin-inline: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}

	.brand {
		font-family: var(--font-mono);
		font-size: 22px;
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
		letter-spacing: -0.02em;
	}

	.tools {
		display: flex;
		align-items: center;
		gap: 2px;
	}

	.icon-button {
		display: inline-grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: var(--r-chip);
		color: var(--muted);
	}

	.icon-button:hover {
		color: var(--text);
	}

	.icon-button svg {
		width: 21px;
		height: 21px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
