---
import { SITE } from '../site.config';
import { withBase } from '../utils/withBase';

// B-7 비어 있는 소셜 링크는 그리지 않는다
const links = [
	SITE.socials.github && { href: SITE.socials.github, label: 'GitHub' },
	SITE.socials.email && { href: `mailto:${SITE.socials.email}`, label: '이메일' },
	{ href: withBase('/rss.xml'), label: 'RSS' },
].filter((link): link is { href: string; label: string } => Boolean(link));
---

<footer class="site-footer">
	<div class="container">
		<ul>
			{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 96px;
		padding-block: 28px 40px;
		border-top: 1px solid var(--line);
	}

	ul {
		display: flex;
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--fs-sm);
	}

	a {
		color: var(--muted);
		text-decoration: none;
	}

	a:hover {
		color: var(--text);
		text-decoration: underline;
	}
</style>
