---
// 노트 목록. hudi.blog처럼 큰 제목, 날짜, 요약, 회색 칩 순서로 그린다
// 정렬은 하지 않고 받은 순서 그대로 그린다 (정렬은 도메인의 일)
import type { Note } from '../lib/notes';
import { slugify } from '../lib/notes';
import { formatDate } from '../utils/format';
import { withBase } from '../utils/withBase';

interface Props {
	notes: Note[];
	compact?: boolean;
}

const { notes, compact = false } = Astro.props;
---

{
	notes.length === 0 ? (
		<p class="empty">아직 노트가 없습니다.</p>
	) : (
		<ul class:list={['notes', { compact }]}>
			{notes.map((note) => (
				<li>
					<a class="title" href={withBase(`/notes/${note.id}/`)}>
						{note.data.pinned && <span class="pin">고정</span>}
						{note.data.title}
					</a>
					<time class="date num" datetime={note.data.date.toISOString()}>
						{formatDate(note.data.date)}
					</time>
					{!compact && <p class="desc">{note.data.description}</p>}
					{!compact && (
						<p class="chips">
							<a href={withBase(`/categories/${slugify(note.data.category)}/`)}>{note.data.category}</a>
							{note.data.tags.map((tag) => (
								<a href={withBase(`/tags/${slugify(tag)}/`)}>{tag}</a>
							))}
						</p>
					)}
				</li>
			))}
		</ul>
	)
}

<style>
	.notes {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.notes > li {
		display: flex;
		flex-direction: column;
		padding-block: 40px;
		border-bottom: 1px solid var(--line);
	}

	.compact > li {
		flex-direction: row-reverse;
		justify-content: flex-end;
		align-items: baseline;
		gap: 16px;
		padding-block: 12px;
		border-bottom: 0;
	}

	.title {
		font-size: var(--fs-h1);
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: -0.02em;
		color: var(--text);
		text-decoration: none;
	}

	.compact .title {
		font-size: var(--fs-body);
		font-weight: 500;
		letter-spacing: 0;
	}

	.title:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.pin {
		display: inline-block;
		margin-right: 8px;
		padding: 0 8px;
		border-radius: var(--r-chip);
		background: var(--accent-bg);
		font-size: var(--fs-meta);
		font-weight: 600;
		letter-spacing: 0;
		vertical-align: 5px;
	}

	.date {
		margin-top: 12px;
		color: var(--muted);
		font-size: var(--fs-sm);
	}

	.compact .date {
		flex: none;
		margin-top: 0;
		font-size: var(--fs-meta);
	}

	.desc {
		margin: 16px 0 0;
		color: var(--muted);
		font-size: var(--fs-sm);
		line-height: 1.8;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 20px 0 0;
	}

	.chips a {
		padding: 5px 13px;
		border-radius: var(--r-chip);
		background: var(--accent-bg);
		color: var(--text);
		font-size: var(--fs-meta);
		text-decoration: none;
	}

	.chips a:hover {
		background: var(--line);
	}

	.empty {
		margin-top: 40px;
		color: var(--muted);
	}
</style>
