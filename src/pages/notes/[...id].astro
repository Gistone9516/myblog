---
// 노트 페이지 (설계서 5장). 본문만 검색 색인에 들어간다 (B-10)
import '../../styles/prose.css';
import NoteNav from '../../components/NoteNav.astro';
import Toc from '../../components/Toc.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadNotes, renderNote, type NoteEntry } from '../../lib/content';
import { groupBySeries, seriesPosition, slugify, type SeriesPosition } from '../../lib/notes';
import { formatDate } from '../../utils/format';
import { seriesColorVar } from '../../utils/series';
import { withBase } from '../../utils/withBase';

export async function getStaticPaths() {
	const notes = await loadNotes();
	const groups = groupBySeries(notes);
	return notes.map((entry) => ({
		params: { id: entry.id },
		props: { entry, position: seriesPosition(entry, groups) },
	}));
}

interface Props {
	entry: NoteEntry;
	position?: SeriesPosition<NoteEntry>;
}

const { entry, position } = Astro.props;
const { Content, headings } = await renderNote(entry);
const { title, description, date, updated, category, tags, series } = entry.data;
---

<BaseLayout title={title} description={description}>
	<div class="note-layout">
		<article class="note" data-pagefind-body>
			<header class="note-head">
				<p class="meta">
					<a class="category" href={withBase(`/categories/${slugify(category)}/`)}>{category}</a>
					{
						series && position && (
							<a class="series" href={withBase(`/series/${slugify(series)}/`)} style={`--spine-color: ${seriesColorVar(series)}`}>
								{series} <span class="num">{position.index}/{position.total}</span>
							</a>
						)
					}
					<time class="num" datetime={date.toISOString()}>{formatDate(date)}</time>
					{updated && <span class="updated num">수정 {formatDate(updated)}</span>}
				</p>
				<h1>{title}</h1>
			</header>

			<Toc headings={headings} variant="inline" />

			<div class="prose">
				<Content />
			</div>

			{
				tags.length > 0 && (
					<p class="tags" data-pagefind-ignore>
						{tags.map((tag) => (
							<a href={withBase(`/tags/${slugify(tag)}/`)}>#{tag}</a>
						))}
					</p>
				)
			}

			<div data-pagefind-ignore>
				<NoteNav prev={position?.prev} next={position?.next} />
			</div>
		</article>

		<aside class="side">
			<Toc headings={headings} variant="side" />
		</aside>
	</div>
</BaseLayout>

<style>
	.note-layout {
		width: min(100% - var(--gutter) * 2, calc(var(--measure) + 268px));
		margin: 56px auto 0;
		display: grid;
		grid-template-columns: minmax(0, var(--measure)) 220px;
		gap: 48px;
		align-items: start;
	}

	.side {
		position: sticky;
		top: 24px;
	}

	.note-head {
		margin-bottom: 32px;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 14px;
		margin: 0 0 14px;
		font-size: var(--fs-meta);
		color: var(--muted);
	}

	.category {
		padding: 2px 10px;
		border-radius: var(--r-chip);
		background: var(--accent-bg);
		color: var(--accent);
		text-decoration: none;
	}

	/* 연재 표시 앞의 작은 책등 마크. 대표 화면 카드와 같은 색이다 (B-16) */
	.series {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--text);
		text-decoration: none;
	}

	.series::before {
		content: '';
		width: 4px;
		height: 14px;
		border-radius: 2px;
		background: var(--spine-color);
	}

	.series:hover {
		text-decoration: underline;
	}

	h1 {
		margin: 0;
		font-size: var(--fs-title);
		line-height: 1.3;
		letter-spacing: -0.02em;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 14px;
		margin: 48px 0 0;
		font-size: var(--fs-sm);
	}

	.tags a {
		color: var(--muted);
		text-decoration: none;
	}

	.tags a:hover {
		color: var(--accent);
	}

	/* 좁은 화면에서는 옆 목차를 숨기고 본문 위의 접힌 목차를 쓴다 (B-14) */
	@media (min-width: 1081px) {
		.note :global(.toc-inline) {
			display: none;
		}
	}

	@media (max-width: 1080px) {
		.note-layout {
			grid-template-columns: minmax(0, 1fr);
			width: min(100% - var(--gutter) * 2, var(--measure));
		}

		.side {
			display: none;
		}
	}
</style>
