---
import PageHeading from '../components/PageHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, hasProfile } from '../site.config';

const { profile } = SITE;
---

<BaseLayout title="소개">
	<div class="container">
		<PageHeading title={profile.name || '소개'} lead={profile.oneLiner || undefined} />
		{
			hasProfile ? (
				<div class="about">
					{profile.intro && <p>{profile.intro}</p>}
					{profile.focus.length > 0 && (
						<p class="focus">
							<span>지금 공부 중</span>
							{profile.focus.map((item) => (
								<span class="badge">{item}</span>
							))}
						</p>
					)}
				</div>
			) : (
				<p class="empty">아직 소개를 작성하지 않았습니다.</p>
			)
		}
	</div>
</BaseLayout>

<style>
	.about p {
		margin: 0 0 1em;
		max-width: var(--measure);
	}

	.focus {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		font-size: var(--fs-sm);
		color: var(--muted);
	}

	.badge {
		padding: 2px 10px;
		border-radius: var(--r-chip);
		background: var(--accent-bg);
		color: var(--accent);
	}

	.empty {
		color: var(--muted);
	}
</style>
