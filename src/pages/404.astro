---
import PageHeading from '../components/PageHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/withBase';
---

<BaseLayout title="페이지를 찾을 수 없음">
	<div class="container">
		<PageHeading title="페이지를 찾을 수 없습니다" lead="주소가 바뀌었거나 지워진 노트일 수 있습니다." />
		<p><a href={withBase('/notes/')}>전체 노트에서 찾아보기</a></p>
	</div>
</BaseLayout>
