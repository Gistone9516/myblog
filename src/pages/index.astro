---
// 대표 화면 (설계서 5장)
import ChipList from '../components/ChipList.astro';
import NoteList from '../components/NoteList.astro';
import SeriesShelf from '../components/SeriesShelf.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadNotes } from '../lib/content';
import { groupByCategory, groupBySeries, siteStats, sortForList } from '../lib/notes';
import { SITE } from '../site.config';
import { withBase } from '../utils/withBase';

const RECENT_COUNT = 8;
const SHELF_COUNT = 4;

const notes = await loadNotes();
const recent = sortForList(notes).slice(0, RECENT_COUNT);
const series = groupBySeries(notes);
const categories = groupByCategory(notes);
const stats = siteStats(notes);
const { profile } = SITE;
---

<BaseLayout>
	<div class="container home">
		<section class="intro">
			<!-- B-7 프로필이 비어 있으면 사이트 이름과 사이트 소개를 쓴다 -->
			<h1>{profile.name || SITE.title}</h1>
			<p class="lead">{profile.oneLiner || SITE.description}</p>
			{
				profile.focus.length > 0 && (
					<p class="focus">
						<span class="focus-label">지금 공부 중</span>
						{profile.focus.map((item) => (
							<span class="badge">{item}</span>
						))}
					</p>
				)
			}
			{profile.intro && <p class="bio">{profile.intro}</p>}
			<!-- B-6 지표는 문장 한 줄로, 숫자만 굵게 -->
			<p class="stats">
				노트 <strong class="num">{stats.notes}</strong>편, 연재 <strong class="num">{stats.series}</strong>개,{' '}
				<strong class="num">{stats.days}</strong>일 기록
			</p>
		</section>

		{
			series.length > 0 && (
				<section>
					<div class="section-head">
						<h2>연재</h2>
						<a href={withBase('/series/')}>전체 보기</a>
					</div>
					<SeriesShelf groups={series.slice(0, SHELF_COUNT)} />
				</section>
			)
		}

		<section>
			<div class="section-head">
				<h2>최근 노트</h2>
				<a href={withBase('/notes/')}>전체 보기</a>
			</div>
			<NoteList notes={recent} />
		</section>

		{
			categories.length > 0 && (
				<section>
					<div class="section-head">
						<h2>분류</h2>
					</div>
					<ChipList items={categories} kind="categories" />
				</section>
			)
		}
	</div>
</BaseLayout>

<style>
	.intro {
		margin: 72px 0 8px;
	}

	h1 {
		margin: 0;
		font-size: var(--fs-title);
		letter-spacing: -0.02em;
	}

	.lead {
		margin: 12px 0 0;
		font-size: var(--fs-body);
		color: var(--muted);
	}

	.focus {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin: 20px 0 0;
		font-size: var(--fs-sm);
	}

	.focus-label {
		color: var(--muted);
		margin-right: 4px;
	}

	.badge {
		padding: 2px 10px;
		border-radius: var(--r-chip);
		background: var(--accent-bg);
		color: var(--accent);
	}

	.bio {
		margin: 20px 0 0;
		max-width: var(--measure);
	}

	.stats {
		margin: 24px 0 0;
		font-size: var(--fs-sm);
		color: var(--muted);
	}

	.stats strong {
		color: var(--text);
		font-weight: 600;
	}

	section + section {
		margin-top: 56px;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 20px;
	}

	h2 {
		margin: 0;
		font-size: var(--fs-h2);
	}

	.section-head a {
		font-size: var(--fs-sm);
		color: var(--muted);
		text-decoration: none;
	}

	.section-head a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
</style>
