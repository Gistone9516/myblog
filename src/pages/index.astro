---
// 대표 화면: 프로필, 탭, 글 목록 (설계서 5장, hudi.blog 형식)
import NoteList from '../components/NoteList.astro';
import ProfileTabs from '../components/ProfileTabs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadNotes } from '../lib/content';
import { sortForList } from '../lib/notes';

const notes = sortForList(await loadNotes());
---

<BaseLayout>
	<div class="container">
		<ProfileTabs active="notes" noteCount={notes.length} />
		<NoteList notes={notes} />
	</div>
</BaseLayout>
